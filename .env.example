# --- Supabase (obligatorio) ---------------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_...). También se acepta la antigua anon key
# en NEXT_PUBLIC_SUPABASE_ANON_KEY. Es pública por diseño: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- URL pública de la app ------------------------------------------------
# Se usa en enlaces de invitación y correos de autenticación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opcionales -------------------------------------------------------------
# Nombre que se muestra en el login (antes de saber la empresa). El nombre real
# de la empresa se edita en Ajustes y se guarda en la base de datos.
NEXT_PUBLIC_APP_NAME=Panel de gestión
# Zona horaria para mostrar fechas y horas (por defecto Europe/Madrid).
NEXT_PUBLIC_TIMEZONE=Europe/Madrid

# SOLO SERVIDOR. Nunca con prefijo NEXT_PUBLIC_. Permite enviar las
# invitaciones por correo desde Supabase Auth. Sin ella, las invitaciones se
# crean igual y el administrador comparte el enlace manualmente.
SUPABASE_SERVICE_ROLE_KEY=

# Solo para el script de datos de demostración (npm run seed:demo) en un
# proyecto de DESARROLLO. Nunca lo actives en producción.
ALLOW_DEMO_SEED=false

# Solo scripts de administracion (npm run user:create): cadena de conexion
# (Supabase -> Connect -> Session pooler). Nunca la pongas en Vercel.
DATABASE_URL=
